# Copy to .env for local development. In production set these in your host's environment settings.
# Never commit real values.

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# --- CockroachDB -------------------------------------------------------------
# Cloud (from the Cockroach Cloud console > Connect, "General connection string"):
#   postgresql://<user>:<password>@<cluster-host>.aws-eu-west-1.cockroachlabs.cloud:26257/stjohns?sslmode=verify-full
# Local (docker compose up -d):
DATABASE_URL=postgresql://root@localhost:26257/defaultdb?sslmode=disable
DB_POOL_MAX=10

# --- Public URLs ---------------------------------------------------------------
# The website (GoDaddy domain) and this API. Use the same registrable domain for both
# (www.example.ie + api.example.ie) so the login cookie works.
PUBLIC_SITE_URL=http://localhost:5500
PUBLIC_API_URL=http://localhost:8080
# Comma-separated origins allowed to call the API from a browser (defaults to PUBLIC_SITE_URL).
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Production: .example.ie (leading dot) so www. and api. share the session cookie. Leave empty locally.
COOKIE_DOMAIN=
SESSION_TTL_DAYS=30

# --- Booking rules ---------------------------------------------------------------
TIMEZONE=Europe/Dublin
BOOKING_MAX_DAYS_AHEAD=84
BOOKING_MIN_LEAD_MINUTES=120
CANCEL_CUTOFF_HOURS=24
DEPOSIT_AMOUNT_EUR=30
DEPOSIT_INSTRUCTIONS=We will send you a secure link to pay the deposit.

# --- Business details (used in emails, SMS and calendar entries) -----------------
BUSINESS_NAME=St Johns Park Car Valeting Service
BUSINESS_PHONE=089 470 9672
BUSINESS_ADDRESS=19 Saint Lawrence Terrace, Ballytruckle, St Johns Park, Waterford, X91 H79Y
# Where new-booking alerts go:
OWNER_EMAIL=
OWNER_PHONE=

# --- Resend (email) ---------------------------------------------------------------
RESEND_API_KEY=
# Must be on a domain verified in Resend (DNS records added in GoDaddy):
EMAIL_FROM=St Johns Park Valeting <bookings@example.ie>
EMAIL_REPLY_TO=

# --- Sendmode (SMS) ---------------------------------------------------------------
SENDMODE_ACCESS_KEY=
# Up to 11 letters/numbers, shown as the sender on the customer's phone:
SENDMODE_SENDER_ID=StJohnsPark
# international = 353871234567, national = 0871234567
SENDMODE_NUMBER_FORMAT=international

# --- Google Calendar ---------------------------------------------------------------
# Service account key JSON (raw JSON or base64 of it), and the calendar shared with it.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=

# --- Google Analytics 4 (visitor stats in the admin dashboard) ------------------------
# Numeric property ID (GA Admin › Property settings). Add the service account email above as a Viewer.
GA4_PROPERTY_ID=
# The website's Measurement ID (GA Admin › Data streams). Also set it on <html data-ga-id="..."> in the site.
GA4_MEASUREMENT_ID=

# --- Owner's iPhone / iCloud calendar subscription -----------------------------------
# Long random secret (32+ chars). Subscribe to: <PUBLIC_API_URL>/api/v1/admin/calendar.ics?key=<this>
ADMIN_CALENDAR_FEED_KEY=

# Run the notification worker in this process (set false only if you run it separately).
WORKER_ENABLED=true
