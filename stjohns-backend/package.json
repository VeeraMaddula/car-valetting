{
  "name": "stjohns-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Booking API for St Johns Park Car Valeting Service",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "db:setup": "tsx --env-file-if-exists=.env src/scripts/db-setup.ts",
    "create-admin": "tsx --env-file-if-exists=.env src/scripts/create-admin.ts",
    "email:test": "tsx --env-file-if-exists=.env src/scripts/email-test.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@node-rs/argon2": "^2.2.1",
    "fastify": "^5.12.5",
    "google-auth-library": "^11.1.0",
    "libphonenumber-js": "^1.13.14",
    "pg": "^8.23.1",
    "sharp": "0.35.5",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
